with "config/aaa_config.gpr";

project Aaa is

   for Library_Name use "aaa";
   for Library_Version use Project'Library_Name & ".so." & Aaa_Config.Crate_Version;

   --  OS-specific sources, autodetected from environment

   OS_Sources := ();
   Detect_Windows := external ("SystemRoot", "not_windows");

   case Detect_Windows is
      when "not_windows" =>
         OS_Sources := OS_Sources & ("src/unix/");
      when others =>
         OS_Sources := OS_Sources & ("src/windows/");
   end case;

   for Source_Dirs use ("src/") & OS_Sources;
   for Object_Dir use "obj/" & Aaa_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("AAA_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Local_Configuration_Pragmas use "gnat.adc";
      for Default_Switches ("Ada") use Aaa_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Aaa;
